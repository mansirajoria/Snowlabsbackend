{
  "name": "snow-labs-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typeorm": "env-cmd ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/typeorm.migrations.ts -o src/migrations/migration",
    "migration:create": "npm run typeorm -- migration:create -o src/migrations/migration",
    "migration:run": "npm run typeorm -- migration:run -d src/config/typeorm.migrations.ts ",
    "migration:revert": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:revert",
    "schema:drop": "npm run typeorm -- --dataSource=src/database/data-source.ts schema:drop",
    "seed:create": "hygen seeds create",
    "seed:run": "ts-node -r tsconfig-paths/register ./src/database/seeds/run-seed.ts",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "nodemon": "nodemon -r tsconfig-paths/register src/main.ts --trace-warnings",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "env-cmd jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@google-analytics/data": "^4.12.0",
    "@nestjs-modules/mailer": "1.8.1",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.3.0",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^9.3.0",
    "@nestjs/jwt": "10.0.3",
    "@nestjs/passport": "9.0.3",
    "@nestjs/platform-express": "^9.3.0",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/swagger": "6.3.0",
    "@nestjs/typeorm": "^9.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.15",
    "@types/moment": "^2.13.0",
    "aws-sdk": "^2.1655.0",
    "axios": "^1.7.9",
    "bcryptjs": "2.4.3",
    "cache-manager": "^5.7.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "core-js": "^3.41.0",
    "googleapis": "^127.0.0",
    "handlebars": "^4.7.8",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "multer": "^1.4.5-lts.1",
    "nest-winston": "^1.10.2",
    "nestjs-razorpay": "^1.0.3",
    "nodemailer": "^6.10.0",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "passport-github": "^1.1.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-outlook": "^3.0.0",
    "pg": "^8.13.3",
    "razorpay": "^2.9.5",
    "rimraf": "^5.0.1",
    "rxjs": "7.8.0",
    "sib-api-v3-typescript": "^2.2.2",
    "stripe": "^13.4.0",
    "typeorm": "^0.3.15",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.4.0",
    "@nestjs/testing": "^9.4.3",
    "@types/bcryptjs": "2.4.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "18.15.12",
    "@types/passport-github": "^1.1.12",
    "@types/passport-jwt": "3.0.8",
    "@types/supertest": "2.0.12",
    "@typescript-eslint/eslint-plugin": "5.59.0",
    "@typescript-eslint/parser": "5.59.0",
    "env-cmd": "10.1.0",
    "eslint": "8.38.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "8.0.3",
    "hygen": "6.2.11",
    "is-ci": "3.0.1",
    "jest": "29.5.0",
    "prettier": "2.8.7",
    "supertest": "6.3.3",
    "ts-jest": "29.1.0",
    "ts-node": "10.9.1",
    "typescript": "5.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "overrides": {
    "send": "^0.19.0",
    "serve-static": "^1.16.2",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "cookie": "^0.7.0",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "ws": "^8.17.1"
  }
}
