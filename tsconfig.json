{
  "compileOnSave": true,
  "compilerOptions": {
    "resolveJsonModule": true,
    // "esModuleInterop": true,
    "target": "es2017",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "pretty": true,
    "sourceMap": true,
    "declaration": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "importHelpers": false,
    "baseUrl": "./src",
    "removeComments": true,
    "incremental": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "src/*": ["src/*"],
      "@access/*": ["access-management/*"],
      "@announcement/*": ["announcement/*"],
      "@auth/*": ["auth/*"],
      "@batch/*": ["batch/*"],
      "@blogs/*": ["blogs/*"],
      "@career/*": ["career/*"],
      "@config/*": ["config/*"],
      "@courses/*": ["courses/*"],
      "@category/*": ["category/*"],
      "@dashboard/*": ["dashboard/*"],
      "@faq/*": ["faq/*"],
      "@forum/*": ["forum/*"],
      "@leadsquare/*": ["leadsquare/*"],
      "@mail/*": ["mail/*"],
      "@permission/*": ["permission/*"],
      "@payment/*": ["payment/*"],
      "@reviews/*": ["reviews/*"],
      "@role/*": ["role/*"],
      "@role_permissions/*": ["role-permissions/*"],
      "@security/*": ["security/*"],
      "@skills/*": ["skills/*"],
      "@students_lms/*": ["students-lms/*"],
      "@students/*": ["students/*"],
      "@webinars/*": ["webinars/*"],
      "@trainer/*": ["trainer/*"],
      "@trainer_lms/*": ["trainer-lms/*"],
      "@training-plans/*": ["training-plans/*"],
      "@utils/*": ["utils/*"],
      "@notifications/*": ["notifications/*"],
      "@session/*": ["session/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.json", ".env", "src/**/*.js"],
  "exclude": ["node_modules"]
}
